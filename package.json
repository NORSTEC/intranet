{
  "name": "norstec-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "supabase start && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local supabase/tests/database/authorization.test.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@vercel/oidc": "^3.8.2",
    "google-auth-library": "^11.0.0",
    "motion": "^12.31.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@savaryna/tailwindcss-material-symbols": "^1.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.6",
    "supabase": "2.111.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.26.2"
